# ── OpenAI-Compatible API Configuration ────────────────────────────────────────────
# Your OpenAI-compatible API key for LLM judge (REQUIRED for evaluation)
# Works with: OpenAI, xAI/Grok, DeepSeek, Together AI, Groq, OpenRouter, etc.
# NOTE: See OPENAI_BASE_URL below to configure the API endpoint
OPENAI_API_KEY=

# Grok model to use for judging answers
# Default: grok-4-1-fast-reasoning
# Options: grok-2-1212, grok-beta, grok-4-1-fast-reasoning, etc.
EVAL_MODEL=grok-4-1-fast-reasoning

# Number of parallel judge calls (higher = faster but more API load)
# Default: 5
EVAL_CONCURRENCY=5

# Optional proxy URL for API requests (e.g., socks5://127.0.0.1:1080)
# Leave empty if not needed
PROXY_URL=

# ── OpenAI-Compatible API ────────────────────────────────────────────────────────
# Base URL for OpenAI-compatible API (for judging and QA generation)
# Default: https://api.x.ai/v1 (xAI Grok)
#
# Other popular options:
#   - OpenAI:           https://api.openai.com/v1
#   - DeepSeek:         https://api.deepseek.com/v1
#   - Together AI:      https://api.together.xyz/v1
#   - Groq:             https://api.groq.com/openai/v1
#   - OpenRouter:       https://openrouter.ai/api/v1
#   - Local LLM (Ollama): http://localhost:11434/v1
#   - Local LLM (LM Studio): http://localhost:1234/v1
#   - vLLM:             http://localhost:8000/v1
#
# Make sure your EVAL_MODEL matches the provider's model names.
OPENAI_BASE_URL=https://api.x.ai/v1

# ── Data Paths ─────────────────────────────────────────────────────────────────
# Path to public questions file (used for downloads and validation)
# Default: data/questions/questions_public.jsonl
QUESTIONS_PATH=data/questions/questions_public.jsonl

# Path for questions download button (same as QUESTIONS_PATH by default)
QUESTIONS_DOWNLOAD_PATH=data/questions/questions_public.jsonl

# Path to documents ZIP file for download button
# Default: data/documents.zip
DOCUMENTS_ZIP_PATH=data/documents.zip

# ── Gold Answers (HuggingFace) ─────────────────────────────────────────────────
# HuggingFace token for accessing private gold answers dataset
# Required if using HF dataset; leave empty if using GOLD_PATH_LOCAL
# Get it at: https://huggingface.co/settings/tokens
HF_TOKEN=

# HuggingFace dataset ID containing gold answers
# Default: datakomarov/RAG-data-v2
GOLD_DATASET_ID=datakomarov/RAG-data-v2

# Filename of gold answers within the HF dataset
# Default: answers_gold.jsonl
GOLD_FILENAME=answers_gold.jsonl

# ── Gold Answers (Local Override) ──────────────────────────────────────────────
# Local path to gold answers file (bypasses HF download)
# If set and file exists, HF_TOKEN/GOLD_DATASET_ID are ignored
# Use this for local development or private datasets
GOLD_PATH_LOCAL=

# ── UI Options ─────────────────────────────────────────────────────────────────
# Show detailed evaluation results in the UI (0 = off, 1 = on)
# When enabled, users can see individual question judgements
# Default: 0
SHOW_DETAILS=0

# ── HuggingFace Space Upload (optional) ─────────────────────────────────────────
# Your Space's repo ID for uploading leaderboard results
# Format: username/space-name
# Example: datakomarov/RAG-LB-v2
THIS_SPACE_ID=
